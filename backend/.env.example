# ─── VoiceCart Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.

# JWT secret — use a long random string in production
JWT_SECRET=voicecart_change_this_secret_in_production

# ─── Email (for OTP) ───
# In DEVELOPMENT: Leave these blank → Ethereal test account is used automatically.
# The OTP preview URL is printed to the console so you can view the email.
#
# In PRODUCTION: Fill in your Gmail credentials.
# For Gmail you need an "App Password" (not your regular password).
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Server port
PORT=5000
